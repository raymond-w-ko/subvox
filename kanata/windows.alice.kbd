(defcfg 
process-unmapped-keys no log-layer-changes no tray-icon kanata.ico icon-match-layer-name no )

(defvar 
one-shot-time 500 tap-time 225 hold-time 225 hold-time-slow 275 hold-time-glacial 325 )

(defalias 
l_base (layer-switch base )
l_gaming (layer-switch gaming )
l_shortcut (layer-toggle shortcut )
l_sym1 (layer-toggle sym1 )
l_misc (layer-toggle misc )
l_num (layer-toggle num )
l_fn (layer-toggle fn )
os_lsft (one-shot-release $one-shot-time lsft )
os_rsft (one-shot-release $one-shot-time rsft )
spc (tap-hold $tap-time $hold-time spc lctl )
v (tap-hold $tap-time $hold-time v @l_shortcut )
m (tap-hold $tap-time $hold-time m @l_shortcut )
c (tap-hold $tap-time $hold-time c @l_sym1 )
comm (tap-hold $tap-time $hold-time comm @l_sym1 )
x (tap-hold $tap-time $hold-time x @l_misc )
. (tap-hold $tap-time $hold-time . @l_misc )
z (tap-hold $tap-time $hold-time-slow z @l_num )
/ (tap-hold $tap-time $hold-time-slow / @l_num )
b (tap-hold $tap-time $hold-time b @l_fn )
n (tap-hold $tap-time $hold-time n @l_fn )
s (tap-hold $tap-time $hold-time-slow s lctl )
d (tap-hold $tap-time $hold-time d lalt )
f (tap-hold $tap-time $hold-time f lmet )
l (tap-hold $tap-time $hold-time-slow l rctl )
k (tap-hold $tap-time $hold-time k ralt )
j (tap-hold $tap-time $hold-time-slow j rmet )
a (tap-hold $tap-time $hold-time-glacial a lsft )
scln (tap-hold $tap-time $hold-time-glacial scln rsft )
d_h (tap-hold $tap-time $hold-time del home )
p_e (tap-hold $tap-time $hold-time C-lbrc end )
)

(defsrc 
f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 f11 f12 ins tab q w e r t y u i o p lbrc rbrc bksl grv 1 2 3 4 5 6 7 8 9 0 min = bspc caps a s d f g h j k l scln apos ret lsft z x c v b n m comm . / rsft lctl lalt lmet spc rmet ralt up down left right )

(deflayer 
base f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 f11 f12 ins tab q w e r t y u i o p lbrc rbrc bksl grv 1 2 3 4 5 6 7 8 9 0 min = bspc @os_lsft @a @s @d @f g h @j @k @l @scln @os_rsft ret lsft @z @x @c @v @b @n @m @comm @. @/ @os_rsft lctl lalt lmet @spc rmet @l_gaming up down left right )

(deflayer 
gaming f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 f11 f12 ins tab q w e r t y u i o p lbrc rbrc bksl grv 1 2 3 4 5 6 7 8 9 0 min = bspc spc a s d f g h j k l scln apos ret lsft z x c v b n m comm . / rsft lctl lalt lmet spc rmet @l_base up down left right )

(deflayer 
shortcut • • • • • • • • • • • • • • tab esc • • • • bspc up C-bspc • • • • • • • • • • • • • • • • • • • • • @p_e C-rbrc M-S-s • left down right ret • • • M-grv @d_h C-S-tab C-tab • • • • • • @os_rsft • • • @spc • • • • • • )

(deflayer 
sym1 • • • • • • • • • • • • • • S-1 S-2 S-3 S-4 S-5 S-6 S-7 S-8 S-9 S-0 • • • • • • • • • • • • • • • • • • grv S-min min bksl S-bksl • S-scln scln lbrc rbrc • • • S-grv • S-apos apos • • S-= = S-lbrc S-rbrc @os_rsft • • • @spc • • • • • • )

(deflayer 
misc • • • • • • • • • • • • • • • • A-rbrc A-S-rbrc • • • pgup • • • • • • • • • • • • • • • • • • • • • • A-lbrc A-S-lbrc • • • pgdn • • • • • • • • C-c C-v • • • • • @os_rsft • • • @spc • • • • • • )

(deflayer 
num • • • • • • • • • • • • • • 0 9 8 7 • • 7 8 9 0 • • • • • • • • • • • • • • • • • • kp. 6 5 4 bspc bspc 4 5 6 kp. • • • ret 3 2 1 • • 1 2 3 ret @os_rsft • • • @spc • • • • • • )

(deflayer 
fn • • • • • • • • • • • • • • f10 f9 f8 f7 • • f7 f8 f9 f10 • • • • • • • • • • • • • • • • • • f11 f6 f5 f4 • • f4 f5 f6 f11 • • • f12 f3 f2 f1 • • f1 f2 f3 f12 @os_rsft • • • @spc • • • • • • )

